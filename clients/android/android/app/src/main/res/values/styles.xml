<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window while the process starts: the board's black, whatever the
         system's light/dark setting (the deck has one look). Removed when
         Flutter draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- The window behind the Flutter UI once it runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/deck_bg</item>
    </style>
</resources>
